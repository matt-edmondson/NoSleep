<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />
  <Sdk Name="ktsu.Sdk.Tool" />

  <ItemGroup>
    <!-- The tray host, the console fallback, the standard flags, and the packaging props that trim the
         per-RID SkiaSharp natives out of this tool's payload - all of which used to live in this
         project. Avalonia arrives through it, and is not referenced here because nothing here touches
         it any more. -->
    <PackageReference Include="ktsu.TrayApp" />

    <!-- The persistence stack is assembled here rather than inside ktsu.TrayApp: the library takes
         IPersistenceProvider<string> and nothing else, so a tool picks where its settings live. -->
    <PackageReference Include="ktsu.Essentials" />
    <PackageReference Include="ktsu.Essentials.FileSystemProviders.Native" />
    <PackageReference Include="ktsu.Essentials.PersistenceProviders.ConfigHome" />
    <PackageReference Include="ktsu.Essentials.SerializationProviders.Json" />

    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NoSleep/NoSleep.csproj" />
  </ItemGroup>

  <!-- The tray icons are loaded through Assembly.GetManifestResourceStream rather than
       AvaloniaResource: the tray builds its menu in code and never loads XAML, so pulling in the
       Avalonia resource pipeline for two PNGs would be the only reason it needed one. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/*.png" />
  </ItemGroup>
</Project>
